# Get your Anthropic API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Trip briefings (all set in Vercel; never commit real values) ---
# Your private site key: unlocks Watch buttons and the Briefings panel.
OWNER_KEY=choose_a_long_random_phrase
# Upstash Redis (Vercel Storage tab adds these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Resend (resend.com): API key, and a From address on a verified domain
RESEND_API_KEY=
BRIEFING_FROM=Flight Assistant <briefings@evanburkeen.com>
# Vercel sends this as "Authorization: Bearer ..." to the daily cron
CRON_SECRET=
